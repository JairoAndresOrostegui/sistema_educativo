rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      let user = me();
      return signedIn() && user.status == 'activo' &&
        (!('mustChangePassword' in user) || user.mustChangePassword != true) &&
        (user.role == 'Estudiante' || request.auth.token.email_verified == true);
    }

    function admin() {
      return active() && (me().isSuperadmin == true || me().role == 'Administrador');
    }

    function superadmin() {
      return active() && me().isSuperadmin == true;
    }

    function canEditWebsite() {
      return active() &&
        (me().isSuperadmin == true ||
         (me().permissions is list && me().permissions.hasAny(['sitio_web.editar'])));
    }

    function sameTenantUser(userId) {
      let target = firestore.get(/databases/(default)/documents/users/$(userId)).data;
      return active() &&
        (me().isSuperadmin == true ||
         (target.institution == me().institution && target.campus == me().campus));
    }

    function safeUpload(maxBytes) {
      return request.resource != null && request.resource.size <= maxBytes;
    }

    function hasPermission(permission) {
      return active() &&
        (me().isSuperadmin == true ||
         (me().permissions is list && me().permissions.hasAny([permission])));
    }

    function fileRecord(fileId) {
      return firestore.get(
        /databases/(default)/documents/files/$(fileId)
      ).data;
    }

    function messageAttachment(attachmentId) {
      return firestore.get(
        /databases/(default)/documents/message_attachments/$(attachmentId)
      ).data;
    }

    match /fotos_perfil/{userId}/{fileName} {
      allow read: if active() &&
        (request.auth.uid == userId || sameTenantUser(userId));
      allow create, update: if ((active() && request.auth.uid == userId) ||
        (admin() && sameTenantUser(userId))) &&
        safeUpload(5 * 1024 * 1024) &&
        request.resource.contentType.matches('image/(jpeg|jpg|pjpeg|png)');
      allow delete: if (active() && request.auth.uid == userId) ||
        (admin() && sameTenantUser(userId));
    }

    match /files/{fileId}/{fileName} {
      // Private reads stream through authenticated backend authorization.
      // Storage rules permit at most two distinct Firestore document reads;
      // current child/year/access validation cannot safely fit in that limit.
      allow read: if false;
      allow create: if active() && request.resource.metadata.fileId == fileId &&
        request.resource.metadata.uploadedBy == request.auth.uid &&
        fileRecord(fileId).status == 'uploading' &&
        fileRecord(fileId).uploadedBy == request.auth.uid &&
        fileRecord(fileId).storagePath ==
          'files/' + fileId + '/' + fileName &&
        request.resource.size == fileRecord(fileId).expectedSize &&
        request.resource.contentType == fileRecord(fileId).contentType &&
        safeUpload(25 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /message_attachments/{channelId}/{attachmentId}/{fileName} {
      allow read: if false;
      allow create: if active() &&
        request.resource.metadata.attachmentId == attachmentId &&
        request.resource.metadata.channelId == channelId &&
        request.resource.metadata.uploadedBy == request.auth.uid &&
        messageAttachment(attachmentId).status == 'uploading' &&
        messageAttachment(attachmentId).uploadedBy == request.auth.uid &&
        messageAttachment(attachmentId).channelId == channelId &&
        messageAttachment(attachmentId).storagePath ==
          'message_attachments/' + channelId + '/' + attachmentId + '/' +
          fileName &&
        request.resource.size ==
          messageAttachment(attachmentId).expectedSize &&
        request.resource.contentType ==
          messageAttachment(attachmentId).contentType &&
        safeUpload(25 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /website/{institutionId}/{campusId}/{fileName} {
      allow read: if true;
      allow create, update: if canEditWebsite() &&
        (superadmin() ||
         (institutionId == me().institution && campusId == me().campus)) &&
        safeUpload(10 * 1024 * 1024) &&
        request.resource.contentType.matches('image/(jpeg|jpg|pjpeg|png)');
      allow delete: if canEditWebsite() &&
        (superadmin() ||
         (institutionId == me().institution && campusId == me().campus));
    }

    // Compatibilidad temporal de lectura para imágenes publicadas antes de
    // incorporar institución/sede. Solo superadmin puede retirar estos objetos.
    match /website/{legacyFileName} {
      allow read: if true;
      allow create, update, delete: if superadmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
