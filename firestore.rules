rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      let user = me();
      return signedIn() && user.status == 'activo' &&
        (user.role == 'Estudiante' || request.auth.token.email_verified == true) &&
        (!('mustChangePassword' in user) || user.mustChangePassword != true);
    }

    function admin() {
      return active() && (me().isSuperadmin == true || me().role == 'Administrador');
    }

    function superadmin() {
      return active() && me().isSuperadmin == true;
    }

    function teacher() {
      return active() && me().role == 'Docente';
    }

    function family() {
      return active() && me().role == 'Familiar';
    }

    function hasPermission(permission) {
      let user = me();
      return active() &&
        (user.isSuperadmin == true ||
         (user.permissions is list && user.permissions.hasAny([permission])));
    }

    function canManageUsers() {
      return hasPermission('usuarios.ver') || hasPermission('usuarios.editar');
    }

    function sameTenant(data) {
      let user = me();
      return active() &&
        (user.isSuperadmin == true ||
          ((data.get('institution', '') == user.institution ||
            data.get('institutionId', '') == user.institution) &&
           (data.get('campus', '') == user.campus ||
            data.get('campusId', '') == user.campus)));
    }

    function academicYearActive(data) {
      return data.academicYearId is string &&
        get(/databases/$(database)/documents/academic_years/$(data.academicYearId))
          .data.status == 'active' &&
        sameTenant(get(/databases/$(database)/documents/academic_years/$(data.academicYearId)).data);
    }

    function operationalYearReadable(data) {
      return admin() || academicYearActive(data);
    }

    function enrollmentGroupId(data) {
      return data.data.groupId;
    }

    function activeLinkedChild(studentId) {
      let user = me();
      let child = get(/databases/$(database)/documents/users/$(studentId)).data;
      return active() && user.role == 'Familiar' && studentId is string &&
        user.studentIds is list && studentId in user.studentIds &&
        user.activeStudentId == studentId && child.role == 'Estudiante' &&
        child.status == 'activo' && child.institution == user.institution &&
        child.campus == user.campus;
    }

    function canReadEnrollment(data) {
      return active() && (
        superadmin() ||
        (me().role == 'Administrador' &&
          (hasPermission('matricula.ver') || hasPermission('matricula.editar')) &&
          sameTenant(data)) ||
        (teacher() &&
          (hasPermission('matricula.ver') || hasPermission('matricula.editar')) &&
          sameTenant(data) &&
          me().groupId is string &&
          enrollmentGroupId(data) == me().groupId) ||
        (family() &&
          hasPermission('matricula.ver') &&
          sameTenant(data) &&
          activeLinkedChild(data.vinculaUsuarioId))
      );
    }

    function familyCanReadGroupData(data, permission) {
      let user = me();
      let studentId = user.get('activeStudentId', '');
      let child = get(/databases/$(database)/documents/users/$(studentId)).data;
      return active() && user.role == 'Familiar' &&
        user.permissions is list && user.permissions.hasAny([permission]) &&
        studentId is string && user.studentIds is list &&
        studentId in user.studentIds && child.role == 'Estudiante' &&
        child.status == 'activo' && child.institution == user.institution &&
        child.campus == user.campus && child.groupId == data.groupId;
    }

    function canReadFile(data) {
      let user = me();
      let permissions = user.permissions is list ? user.permissions : [];
      let local = (data.institutionId == user.institution &&
        data.campusId == user.campus);
      return active() && data.status == 'active' &&
        operationalYearReadable(data) && (
          user.isSuperadmin == true ||
          (local && user.role == 'Administrador' && permissions.hasAny([
            'archivos.ver', 'archivos.crear', 'archivos.eliminar'
          ])) ||
          (local && data.recipientUserIds is list &&
            request.auth.uid in data.recipientUserIds &&
            ((user.role == 'Docente' &&
                permissions.hasAny(['archivos.ver'])) ||
              (user.role == 'Estudiante' &&
                permissions.hasAny(['archivos.ver'])))) ||
          (local && user.role == 'Familiar' &&
            permissions.hasAny(['archivos.ver']) &&
            activeLinkedChild(user.activeStudentId) &&
            data.recipientContextKeys is list &&
            request.auth.uid + ':' + user.activeStudentId in
              data.recipientContextKeys)
      );
    }

    match /configuracion_colegios/{id} {
      allow read: if true;
      // La marca institucional se despliega administrativamente. El cliente
      // nunca puede alterar nombre, sedes o identidad visual de una institución.
      allow create, update, delete: if false;
    }

    match /parameters/{id} {
      allow read: if active();
      // Catálogos internos de plataforma. Ningún cliente los administra.
      allow create, update, delete: if false;
    }

    match /academic_groups/{id} {
      allow read: if active() && resource.data.active == true &&
        sameTenant(resource.data) && operationalYearReadable(resource.data);
      allow create, update, delete: if false;
    }

    match /academic_years/{id} {
      allow read: if admin() && hasPermission('parametros.ver') &&
        sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /academic_year_settings/{id} {
      allow read: if active() && sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /academic_year_history/{id} {
      allow read: if admin() && hasPermission('parametros.ver') &&
        sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /teacher_transfers/{id} {
      allow read: if admin() && sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    // Toda lectura y escritura de asistencia pasa por Functions: la lista
    // congelada, el hijo activo y las correcciones se validan en servidor.
    match /attendance_sessions/{id} {
      allow read, create, update, delete: if false;
    }

    match /attendance_records/{id} {
      allow read, create, update, delete: if false;
    }

    match /attendance_history/{id} {
      allow read, create, update, delete: if false;
    }

    match /attendance_notification_events/{id} {
      allow read, create, update, delete: if false;
    }

    // Eventos, respuestas, asistencia y notificaciones se materializan y
    // validan en Functions; el cliente no obtiene acceso directo.
    match /school_events/{id} {
      allow read, create, update, delete: if false;
    }

    match /event_responses/{id} {
      allow read, create, update, delete: if false;
    }

    match /event_attendance/{id} {
      allow read, create, update, delete: if false;
    }

    match /event_history/{id} {
      allow read, create, update, delete: if false;
    }

    match /event_notification_events/{id} {
      allow read, create, update, delete: if false;
    }

    match /academic_group_history/{id} {
      allow read: if admin() && sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId &&
          resource.data.status == 'activo') ||
        (active() && (superadmin() ||
         (family() && me().studentIds is list && userId in me().studentIds &&
          resource.data.role == 'Estudiante' &&
          resource.data.status == 'activo' &&
          resource.data.institution == me().institution &&
          resource.data.campus == me().campus) ||
         (canManageUsers() &&
          resource.data.status in ['activo', 'inactivo'] &&
          resource.data.institution == me().institution &&
          resource.data.campus == me().campus)));

      // La creacion y edicion administrativa pasa por Cloud Functions para
      // validar Auth, unicidad, sede, permisos, vinculos y auditoria.
      allow create: if false;

      allow update: if false;

      // Direcciones de ruta se modifican mediante operaciones autorizadas.

      // Las bajas y eliminaciones pasan por Cloud Functions para coordinar
      // Firebase Auth, dependencias, Storage y auditoria.
      allow delete: if false;
    }

    // Directorio operativo sin documentos, correos, telefonos ni tokens push.
    // Los modulos que necesitan nombres/roles deben consultar esta coleccion.
    match /user_directory/{userId} {
      allow read: if active() &&
        (request.auth.uid == userId || superadmin() ||
         (resource.data.status in ['activo', 'inactivo'] &&
          resource.data.institution == me().institution &&
          resource.data.campus == me().campus));
      allow write: if false;
    }

    match /enrollments/{enrollmentId} {
      allow read: if canReadEnrollment(resource.data) &&
        operationalYearReadable(resource.data);
      // Altas y transiciones pasan por Cloud Functions para validar sede,
      // grado, parentesco, unicidad, estados, notificaciones y auditoria.
      allow create, update, delete: if false;
    }

    match /enrollment_history/{historyId} {
      allow read: if active() && (
        superadmin() ||
        (me().role == 'Administrador' &&
          (hasPermission('matricula.ver') || hasPermission('matricula.editar')) &&
          sameTenant(resource.data)) ||
        (teacher() &&
          (hasPermission('matricula.ver') || hasPermission('matricula.editar')) &&
          sameTenant(resource.data) && resource.data.groupId == me().groupId)
      );
      allow create, update, delete: if false;
    }

    match /enrollment_notification_events/{eventId} {
      allow read: if admin() &&
        (hasPermission('matricula.ver') || hasPermission('matricula.editar')) &&
        sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /enrollment_rate_limits/{rateId} {
      allow read, write: if false;
    }

    match /website/{documentId} {
      allow read: if true;
      allow create: if hasPermission('sitio_web.editar') &&
        request.resource.data.institutionId is string &&
        request.resource.data.campusId is string &&
        sameTenant(request.resource.data) &&
        (documentId != 'config' || request.resource.data.revision == 1);
      allow update: if hasPermission('sitio_web.editar') &&
        sameTenant(resource.data) && sameTenant(request.resource.data) &&
        request.resource.data.institutionId == resource.data.institutionId &&
        request.resource.data.campusId == resource.data.campusId &&
        (documentId != 'config' ||
          (request.resource.data.revision == resource.data.revision + 1) ||
          (request.resource.data.revision == resource.data.revision &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pendingAssetCleanup', 'cleanupUpdatedAt'
            ])));
      allow delete: if hasPermission('sitio_web.editar') &&
        sameTenant(resource.data);
    }

    match /website_pages/{pageId} {
      allow read: if true;
      allow create: if hasPermission('sitio_web.editar') &&
        request.resource.data.institutionId is string &&
        request.resource.data.campusId is string &&
        request.resource.data.publicationRevision is int &&
        sameTenant(request.resource.data) &&
        getAfter(/databases/$(database)/documents/website/config)
          .data.revision == request.resource.data.publicationRevision &&
        ((!exists(/databases/$(database)/documents/website/config) &&
          request.resource.data.publicationRevision == 1) ||
         (exists(/databases/$(database)/documents/website/config) &&
          getAfter(/databases/$(database)/documents/website/config)
            .data.revision ==
          get(/databases/$(database)/documents/website/config)
            .data.revision + 1));
      allow update: if hasPermission('sitio_web.editar') &&
        sameTenant(resource.data) && sameTenant(request.resource.data) &&
        request.resource.data.institutionId == resource.data.institutionId &&
        request.resource.data.campusId == resource.data.campusId &&
        request.resource.data.publicationRevision is int &&
        getAfter(/databases/$(database)/documents/website/config)
          .data.revision == request.resource.data.publicationRevision &&
        getAfter(/databases/$(database)/documents/website/config)
          .data.revision ==
        get(/databases/$(database)/documents/website/config).data.revision + 1;
      allow delete: if hasPermission('sitio_web.editar') &&
        sameTenant(resource.data) && resource.data.publicationRevision is int &&
        getAfter(/databases/$(database)/documents/website/config)
          .data.revision == resource.data.publicationRevision + 1 &&
        getAfter(/databases/$(database)/documents/website/config)
          .data.revision ==
        get(/databases/$(database)/documents/website/config).data.revision + 1;
    }

    match /website_submissions/{submissionId} {
      allow read, delete: if hasPermission('sitio_web.editar') &&
        sameTenant(resource.data);
      allow update: if hasPermission('sitio_web.editar') &&
        sameTenant(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status'
        ]) && request.resource.data.status in ['new', 'read'];
      allow create: if false;
    }

    match /website_form_rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /student_login_rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /notification_rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /message_channels/{channelId} {
      function canReadChannel(data) {
        return active() && hasPermission('mensajeria.ver') &&
          sameTenant(data) && operationalYearReadable(data) &&
          (superadmin() ||
            (data.memberUserIds is list &&
              request.auth.uid in data.memberUserIds));
      }
      allow read: if canReadChannel(resource.data);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        function channel() {
          return get(/databases/$(database)/documents/message_channels/$(channelId)).data;
        }
        allow read: if canReadChannel(channel());
        allow create, update, delete: if false;
      }
    }

    match /messaging_audit/{id} {
      allow read: if admin() && hasPermission('mensajeria.ver') &&
        sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /message_attachments/{id} {
      // Reserva, confirmacion, enlace al mensaje y retencion son atomicos en
      // Functions. El mensaje ya contiene los metadatos visibles necesarios.
      allow read, create, update, delete: if false;
    }

    match /message_attachment_downloads/{id} {
      // Cada descarga se acredita en backend sin permitir falsificacion.
      allow read, create, update, delete: if false;
    }

    match /authorization_requests/{id} {
      allow read: if active() && operationalYearReadable(resource.data) && (
        superadmin() ||
        (me().role == 'Administrador' &&
          (hasPermission('autorizaciones.ver') ||
            hasPermission('autorizaciones.editar')) &&
          sameTenant(resource.data)) ||
        (teacher() && hasPermission('autorizaciones.ver') &&
          sameTenant(resource.data) &&
          resource.data.groupId == me().groupId) ||
        (family() && hasPermission('autorizaciones.ver') &&
          sameTenant(resource.data) &&
          activeLinkedChild(resource.data.studentId))
      );
      allow create, update, delete: if false;
    }

    match /authorization_history/{id} {
      allow read: if active() && (
        superadmin() ||
        (me().role == 'Administrador' &&
          (hasPermission('autorizaciones.ver') ||
            hasPermission('autorizaciones.editar')) &&
          sameTenant(resource.data)) ||
        (teacher() && hasPermission('autorizaciones.ver') &&
          sameTenant(resource.data) &&
          resource.data.groupId == me().groupId)
      );
      allow create, update, delete: if false;
    }

    match /authorization_notification_events/{id} {
      allow read: if admin() && sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /files/{id} {
      allow get: if signedIn() && (
        (me().status == 'activo' && resource.data.status == 'uploading' &&
          resource.data.uploadedBy == request.auth.uid) ||
        canReadFile(resource.data)
      );
      // El listado pasa por listarArchivos para validar sede y contexto del
      // hijo activo sin depender de que las reglas actuen como filtro.
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /file_notification_events/{id} {
      allow read: if admin() && sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /file_download_receipts/{id} {
      // Los acuses se registran y consultan mediante Functions para impedir
      // que un cliente falsifique una lectura o enumere actividad ajena.
      allow read, create, update, delete: if false;
    }

    match /file_storage_usage/{id} {
      allow read: if active() &&
        (superadmin() || resource.data.institutionId == me().institution) &&
        (me().role == 'Administrador' || me().role == 'Docente');
      allow create, update, delete: if false;
    }

    match /file_history/{id} {
      allow read: if admin() && hasPermission('historial.ver') &&
        sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /subjects/{id} {
      allow read: if active() && sameTenant(resource.data) &&
        operationalYearReadable(resource.data) && (
        superadmin() ||
        (me().role == 'Administrador' &&
          (hasPermission('horarios.ver') ||
            hasPermission('horarios.crear') ||
            hasPermission('horarios.editar') ||
            hasPermission('horarios.eliminar'))) ||
        (teacher() && hasPermission('horarios.ver') &&
          (resource.data.teacherId == request.auth.uid ||
            resource.data.groupId == me().groupId)) ||
        (me().role == 'Estudiante' && hasPermission('horarios.ver') &&
          resource.data.groupId == me().groupId) ||
        familyCanReadGroupData(resource.data, 'horarios.ver')
      );
      allow create, update, delete: if false;
    }

    match /routes/{id} {
      allow read: if sameTenant(resource.data) &&
        hasPermission('rutas.ver') &&
        (admin() || resource.data.gestionador == request.auth.uid);
      allow write: if false;
    }

    match /daily_routes/{routeId} {
      function selectedRouteStudent() {
        return me().role == 'Estudiante' ? request.auth.uid : me().activeStudentId;
      }
      function ownRouteStudent(studentId) {
        return active() && (me().role == 'Estudiante' && request.auth.uid == studentId ||
          family() && me().activeStudentId == studentId && studentId in me().studentIds &&
          get(/databases/$(database)/documents/users/$(studentId)).data.status == 'activo' &&
          sameTenant(get(/databases/$(database)/documents/users/$(studentId)).data));
      }
      function canReadRoute() {
        return (admin() && hasPermission('historial.ver')) ||
          (hasPermission('rutas.ver') &&
           (admin() || resource.data.gestionador == request.auth.uid ||
           (!('teacherPosition' in resource.data) && ownRouteStudent(selectedRouteStudent()) &&
            exists(/databases/$(database)/documents/daily_routes/$(routeId)/students/$(selectedRouteStudent())))));
      }
      allow read: if sameTenant(resource.data) && canReadRoute();
      allow write: if false;

      match /live/{locationId} {
        function canReadLive() {
          let user = me();
          let route = get(/databases/$(database)/documents/daily_routes/$(routeId)).data;
          let year = get(/databases/$(database)/documents/academic_years/$(route.academicYearId)).data;
          let privileged = user.isSuperadmin == true;
          let permitted = privileged ||
            (user.permissions is list && user.permissions.hasAny(['rutas.ver']));
          return active() && permitted && route.estado == 'activa' &&
            year.status == 'active' && year.institutionId == route.institution &&
            year.campusId == route.campus &&
            (privileged || (route.institution == user.institution &&
              route.campus == user.campus)) &&
            (privileged || user.role == 'Administrador' ||
              route.gestionador == request.auth.uid || liveForChild(user));
        }
        function liveForChild(user) {
          let studentId = user.role == 'Estudiante' ? request.auth.uid :
            user.get('activeStudentId', '');
          let student = get(/databases/$(database)/documents/users/$(studentId)).data;
          let stop = get(/databases/$(database)/documents/daily_routes/$(routeId)/students/$(studentId)).data;
          return (user.role == 'Estudiante' ||
            (user.role == 'Familiar' && user.studentIds is list &&
              studentId in user.studentIds)) &&
            student.role == 'Estudiante' && student.status == 'activo' &&
            student.institution == user.institution && student.campus == user.campus &&
            stop.activo == true && stop.mapEnabled == true &&
            stop.recogido == false && stop.anulado == false;
        }
        allow read: if signedIn() && canReadLive();
        allow write: if false;
      }

      match /students/{studentId} {
        function route() {
          return get(/databases/$(database)/documents/daily_routes/$(routeId)).data;
        }
        allow read: if sameTenant(route()) &&
          ((admin() && hasPermission('historial.ver')) ||
           (hasPermission('rutas.ver') &&
            (admin() || route().gestionador == request.auth.uid || ownRouteStudent(studentId))));
        allow write: if false;
      }
    }

    match /user_logs/{id} {
      allow create, update, delete: if false;
      allow read: if (admin() && hasPermission('historial.ver') &&
          sameTenant(resource.data)) ||
        (active() && resource.data.userId == request.auth.uid);
    }

    match /user_history/{id} {
      allow read: if admin() && hasPermission('historial.ver') &&
        sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /routes_admin_history/{id} {
      allow read: if admin() && hasPermission('historial.ver') &&
        sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /route_history/{id} {
      allow read: if admin() && hasPermission('historial.ver') &&
        sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /schedule_history/{id} {
      allow read: if admin() && hasPermission('historial.ver') &&
        sameTenant(resource.data);
      allow create, update, delete: if false;
    }

    match /schedule_notification_events/{id} {
      allow read: if admin() &&
        (hasPermission('horarios.ver') ||
          hasPermission('horarios.crear') ||
          hasPermission('horarios.editar') ||
          hasPermission('horarios.eliminar')) &&
        sameTenant(resource.data);
      allow create, update, delete: if false;
    }

  }
}
