DirectoryIndex index.html
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^about/?$ /nosotros/ [R=302,L]
  RewriteRule ^admissions/?$ /admisiones/ [R=302,L]
  RewriteRule ^learning/?$ /aprendizaje/ [R=302,L]
  RewriteRule ^news-events/?$ /vida-escolar/ [R=302,L]
  RewriteRule ^parents/?$ /familias/ [R=302,L]
  RewriteRule ^alternativas(/.*)?$ / [R=302,L]
  RewriteRule ^propuesta-(campus|esencia)/?$ / [R=302,L]
  RewriteRule ^propuesta-campus/assets/(.*)$ /sitio/assets/$1 [R=302,L]
  RewriteRule ^propuesta-(campus|esencia)/([^/]+)/?$ /$2/ [R=302,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ plataforma/index.html [L]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
